# ============================================================
# Six-Country Info Insights - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ----------------------------------------------------------
# Google Cloud / Gemini AI (required for AI summarisation)
# ----------------------------------------------------------
# Your Google Cloud project ID (e.g., my-project-123456)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# (Optional) Gemini model to use. Defaults to gemini-3.5-flash.
# IMPORTANT: gemini-2.0-flash was retired by Google on 2026-06-01 and returns
# 404. Use a current model. Override here without changing code when Google
# retires the next one. See: Vertex AI "Model versions and lifecycle".
# Alternatives: gemini-3.1-flash-lite (cheaper), gemini-2.5-flash (retires 2026-10-16).
# GEMINI_MODEL=gemini-3.5-flash

# (Optional) Vertex AI location/region. Defaults to "global".
# GOOGLE_CLOUD_LOCATION=global

# Path to service account JSON file (local development)
# GOOGLE_SA_FILE=path/to/service-account.json

# OR: paste full JSON content (CI/CD - stored as GitHub Secret)
# GOOGLE_SA_JSON={"type":"service_account","project_id":"..."}

# ----------------------------------------------------------
# Email SMTP Configuration (optional — for email delivery)
# ----------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
FROM_EMAIL=your-email@gmail.com
TO_EMAIL=recipient@example.com

# ----------------------------------------------------------
# Feishu / Lark Configuration (required for bot delivery)
# Create an app at https://open.feishu.cn/app
# ----------------------------------------------------------
FEISHU_APP_ID=cli_...
FEISHU_APP_SECRET=...

# Optional: your personal Open ID for admin access to generated docs
FEISHU_ADMIN_OPEN_ID=ou_...

# Shared archive root and exact child folder names
FEISHU_ARCHIVE_ROOT_FOLDER_TOKEN=Cwkdf77bjldi8Xd3liac3NHDnPb
FEISHU_SIX_COUNTRY_FOLDER_NAME=六国洞察报告
FEISHU_AI_INSIGHTS_FOLDER_NAME=AI洞察报告

# Optional legacy fallback folder
FEISHU_FOLDER_TOKEN=...

# Chat ID(s) for bot push notifications (comma-separated, starts with oc_...)
FEISHU_BOT_CHAT_ID=oc_...
